---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { absolute, img, SITE_ORIGIN, url } from '../lib/url';
import { webpOf } from '../lib/images';

interface Props {
  title: string;
  description: string;
  /** Ruta sin base, con barra final: 'contacto/'. Vacío para inicio. */
  path: string;
  /** Imagen del hero (relativa a public/images) para precarga y Open Graph. */
  heroImage?: string;
  jsonLd?: Record<string, unknown>[];
  /** Destino del CTA persistente "Diagnosticar mi caso". */
  diagnoseHref?: string;
  noindex?: boolean;
}

const { title, description, path, heroImage, jsonLd = [], diagnoseHref, noindex = false } = Astro.props;
const canonical = absolute(path);
const ogImage = new URL(img(heroImage ?? 'catalogo/turbo-gt2052v-audi-v6-tdi.jpg'), SITE_ORIGIN).href;
const preload = heroImage ? (webpOf(heroImage) ?? heroImage) : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#111827" />
    <link rel="icon" type="image/png" href={img('marca/icono-turbocas.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Turbocas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <link rel="preload" href={url('fonts/inter-400.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('fonts/barlow-condensed-600.woff2')} as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" as="image" href={img(preload)} fetchpriority="high" />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {jsonLd.map((data) => <JsonLd data={data} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header diagnoseHref={diagnoseHref} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileActionBar diagnoseHref={diagnoseHref} />

    <script>
      // Revelado discreto de bloques al entrar en pantalla.
      const all = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        // Lo visible al cargar nunca se oculta; solo se anima lo que queda por debajo.
        all.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-visible');
        });
        const items = all.filter((el) => !el.classList.contains('is-visible'));
        document.documentElement.classList.add('reveal-armed');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
