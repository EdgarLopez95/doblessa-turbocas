---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Item {
  icon?: IconName;
  title: string;
  text: string;
  cta?: { label: string; href: string };
}

interface Props {
  items: Item[];
  columns?: 2 | 3 | 4;
  numbered?: boolean;
  tone?: 'light' | 'dark';
}

const { items, columns = 3, numbered = false, tone = 'light' } = Astro.props;
---

<ul class:list={['features', `cols-${columns}`, tone]}>
  {
    items.map((item, i) => (
      <li class="feature" data-reveal style={`--i: ${i}`}>
        {numbered ? (
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        ) : (
          item.icon && (
            <span class="icon">
              <Icon name={item.icon} />
            </span>
          )
        )}
        <h3 class="title">{item.title}</h3>
        <p class="text">{item.text}</p>
        {item.cta && (
          <a class="link-arrow f-cta" href={item.cta.href}>
            {item.cta.label} <Icon name="arrow" />
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  .features {
    list-style: none;
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 640px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .cols-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .feature {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 2px solid var(--ink-950);
  }

  .dark .feature {
    border-top-color: var(--turbo-500);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--s-2);
    border-radius: var(--radius-sm);
    background: var(--steel-100);
    color: var(--ink-950);
  }

  .dark .icon {
    background: rgb(255 255 255 / 0.08);
    color: var(--turbo-500);
  }

  .num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--steel-700);
    letter-spacing: 0.04em;
  }

  .dark .num {
    color: var(--turbo-500);
  }

  .title {
    font-size: 1.3125rem;
  }

  .text {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .dark .text {
    color: var(--steel-300);
  }

  .f-cta {
    margin-top: auto;
    padding-top: var(--s-2);
  }
</style>
