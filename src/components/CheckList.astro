---
import Icon from './Icon.astro';

interface Props {
  items: string[];
  columns?: 1 | 2;
  tone?: 'light' | 'dark';
}

const { items, columns = 1, tone = 'light' } = Astro.props;
---

<ul class:list={['checks', `cols-${columns}`, tone]}>
  {
    items.map((item) => (
      <li>
        <span class="mark">
          <Icon name="check" size={16} />
        </span>
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .checks {
    list-style: none;
    display: grid;
    gap: var(--s-3) var(--s-6);
  }

  @media (min-width: 640px) {
    .cols-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--s-3);
    align-items: start;
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--border);
    line-height: 1.5;
  }

  .dark li {
    border-bottom-color: rgb(255 255 255 / 0.12);
  }

  .mark {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--turbo-500);
    color: var(--ink-950);
  }
</style>
