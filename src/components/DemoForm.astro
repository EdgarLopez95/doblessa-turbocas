---
import Icon from './Icon.astro';
import { business, serviceOptions } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** Prefijo único para los ids de los campos. */
  id: string;
  title: string;
  intro?: string;
  submitLabel?: string;
  defaultService?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  id,
  title,
  intro,
  submitLabel = 'Solicitar diagnóstico',
  defaultService,
  headingLevel = 'h2',
} = Astro.props;
const Heading = headingLevel;
const f = (name: string) => `${id}-${name}`;
---

<div class="demo-form" data-demo-form>
  <Heading class="form-title" id={f('titulo')}>{title}</Heading>
  {intro && <p class="form-intro">{intro}</p>}

  <p class="notice" id={f('aviso')}>
    <Icon name="info" size={20} />
    <span>Formulario demostrativo: no envía ni guarda ningún dato.</span>
  </p>

  <p class="from-ref" data-from-ref hidden>
    <Icon name="package" size={20} />
    <span>Consulta sobre <strong data-from-ref-text></strong></span>
  </p>

  <form novalidate aria-labelledby={f('titulo')} aria-describedby={f('aviso')}>
    <fieldset class="field fieldset-tipo">
      <legend class="label">¿Eres un taller profesional?</legend>
      <div class="radios">
        <label class="radio-label">
          <input type="radio" name="tipo" value="particular" id={f('tipo-particular')} checked />
          <span>No, soy particular</span>
        </label>
        <label class="radio-label">
          <input type="radio" name="tipo" value="taller" id={f('tipo-taller')} />
          <span>Sí, soy un taller</span>
        </label>
      </div>
    </fieldset>

    <div class="field">
      <label for={f('servicio')}>¿Qué necesitas?</label>
      <select class="input" id={f('servicio')} name="servicio" required aria-describedby={f('servicio-error')}>
        <option value="">Selecciona una opción</option>
        {serviceOptions.map((o) => <option selected={o === defaultService}>{o}</option>)}
      </select>
      <p class="error" id={f('servicio-error')} hidden>Elige el tipo de servicio.</p>
    </div>

    <div class="field">
      <label for={f('vehiculo')}>Vehículo o referencia <span class="optional">(opcional)</span></label>
      <input class="input" id={f('vehiculo')} name="vehiculo" type="text" autocomplete="off" aria-describedby={f('vehiculo-hint')} />
      <p class="hint" id={f('vehiculo-hint')}>Marca, modelo, motor o la referencia de la pieza si la tienes.</p>
    </div>

    <div class="row">
      <div class="field">
        <label for={f('nombre')}>Nombre</label>
        <input class="input" id={f('nombre')} name="nombre" type="text" autocomplete="name" required aria-describedby={f('nombre-error')} />
        <p class="error" id={f('nombre-error')} hidden>Indica tu nombre.</p>
      </div>
      <div class="field">
        <label for={f('localidad')}>Localidad</label>
        <input class="input" id={f('localidad')} name="localidad" type="text" autocomplete="address-level2" required aria-describedby={f('localidad-error')} />
        <p class="error" id={f('localidad-error')} hidden>Indica tu localidad.</p>
      </div>
    </div>

    <div class="field">
      <label for={f('contacto')}>Teléfono o email</label>
      <input
        class="input"
        id={f('contacto')}
        name="contacto"
        type="text"
        inputmode="email"
        autocomplete="email"
        required
        data-contact
        aria-describedby={`${f('contacto-hint')} ${f('contacto-error')}`}
      />
      <p class="hint" id={f('contacto-hint')}>Solo para responder a tu consulta.</p>
      <p class="error" id={f('contacto-error')} hidden>Escribe un teléfono de 9 cifras o un email válido.</p>
    </div>

    <div class="field">
      <label for={f('caso')}>Describe el caso</label>
      <textarea class="input" id={f('caso')} name="caso" rows="4" required aria-describedby={`${f('caso-hint')} ${f('caso-error')}`}></textarea>
      <p class="hint" id={f('caso-hint')}>Qué notas, desde cuándo y si se ha encendido algún testigo.</p>
      <p class="error" id={f('caso-error')} hidden>Cuéntanos brevemente qué ocurre.</p>
    </div>

    <div class="field consent">
      <div class="check">
        <input id={f('consentimiento')} name="consentimiento" type="checkbox" required aria-describedby={f('consentimiento-error')} />
        <label for={f('consentimiento')}>
          He leído la <a href={url('politica-de-privacidad/')}>política de privacidad</a> y acepto que se usen mis datos para responder a esta consulta.
        </label>
      </div>
      <p class="error" id={f('consentimiento-error')} hidden>Necesitamos tu consentimiento para responder.</p>
    </div>

    <button class="btn btn-primary submit" type="submit" disabled data-submit>
      {submitLabel}
      <Icon name="arrow" />
    </button>
    <noscript><p class="hint">Activa JavaScript para probar esta demostración.</p></noscript>

    <div class="status" role="status" aria-live="polite" data-status></div>
  </form>

  <div class="summary" data-summary hidden>
    <h3 class="sum-title" tabindex="-1" data-summary-title>
      <span class="sum-check"><Icon name="check" size={20} /></span>
      Resumen de tu solicitud
    </h3>
    <p class="notice sum-demo">
      <Icon name="info" size={20} />
      <span>Solicitud demostrativa: en la web real este formulario conectará con el equipo de Turbocas.</span>
    </p>
    <dl class="sum-list" data-summary-list></dl>
    <p class="sum-next">Qué pasaría a continuación</p>
    <ol class="sum-steps">
      <li><span>01</span> Revisamos los datos del vehículo y los síntomas.</li>
      <li><span>02</span> Te contactamos para aclarar lo que necesitemos.</li>
      <li><span>03</span> Te indicamos el diagnóstico necesario y el presupuesto, sin compromiso de reparar.</li>
    </ol>
    <div class="sum-actions">
      <button class="btn btn-outline btn-sm" type="button" data-edit>Modificar la solicitud</button>
      <a class="btn btn-secondary btn-sm" href={business.phoneHref}><Icon name="phone" /> {business.phoneDisplay}</a>
    </div>
  </div>
</div>

<script>
  const PHONE = /^(\+?34)?[\s-]*[6789](?:[\s-]*\d){8}$/;
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const LABELS: Record<string, string> = {
    tipo: 'Tipo de cliente',
    servicio: 'Servicio',
    vehiculo: 'Vehículo o referencia',
    nombre: 'Nombre',
    localidad: 'Localidad',
    contacto: 'Teléfono o email',
    caso: 'Descripción del caso',
  };

  document.querySelectorAll<HTMLElement>('[data-demo-form]').forEach((wrap) => {
    const form = wrap.querySelector('form');
    const submit = wrap.querySelector<HTMLButtonElement>('[data-submit]');
    const status = wrap.querySelector<HTMLElement>('[data-status]');
    const summary = wrap.querySelector<HTMLElement>('[data-summary]');
    const summaryList = wrap.querySelector<HTMLElement>('[data-summary-list]');
    const summaryTitle = wrap.querySelector<HTMLElement>('[data-summary-title]');
    if (!form || !submit || !status) return;
    submit.disabled = false;

    // La selección hecha en el catálogo o en una landing llega por la URL.
    const params = new URLSearchParams(window.location.search);
    const service = form.querySelector<HTMLSelectElement>('select[name="servicio"]');
    const vehicle = form.querySelector<HTMLInputElement>('input[name="vehiculo"]');
    const preService = params.get('servicio');
    const preRef = params.get('ref')?.slice(0, 120);
    const preTipo = params.get('tipo');

    if (preTipo === 'taller') {
      const radioTaller = form.querySelector<HTMLInputElement>('input[name="tipo"][value="taller"]');
      if (radioTaller) radioTaller.checked = true;
    }

    if (service && preService && Array.from(service.options).some((o) => o.value === preService)) {
      service.value = preService;
    }
    if (vehicle && preRef) {
      vehicle.value = preRef;
      const chip = wrap.querySelector<HTMLElement>('[data-from-ref]');
      const chipText = wrap.querySelector<HTMLElement>('[data-from-ref-text]');
      if (chip && chipText) {
        chipText.textContent = preRef;
        chip.hidden = false;
      }
    }

    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]'));

    const validate = (field: (typeof fields)[number]) => {
      let ok: boolean;
      if (field instanceof HTMLInputElement && field.type === 'checkbox') ok = field.checked;
      else if (field.hasAttribute('data-contact')) {
        const v = field.value.trim();
        ok = PHONE.test(v) || EMAIL.test(v);
      } else ok = field.value.trim().length > 0;

      const error = form.querySelector<HTMLElement>(`#${field.id}-error`);
      field.setAttribute('aria-invalid', String(!ok));
      if (error) error.hidden = ok;
      return ok;
    };

    fields.forEach((field) => {
      const evt = field instanceof HTMLInputElement && field.type === 'checkbox' ? 'change' : 'blur';
      field.addEventListener(evt, () => {
        if (field.getAttribute('aria-invalid') !== null || field.value) validate(field);
      });
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const invalid = fields.filter((field) => !validate(field));
      if (invalid.length) {
        status.className = 'status is-error';
        status.textContent = `Revisa ${invalid.length === 1 ? 'el campo marcado' : `los ${invalid.length} campos marcados`}.`;
        invalid[0].focus();
        return;
      }
      status.className = 'status';
      status.textContent = '';

      if (!summary || !summaryList) {
        status.className = 'status is-success';
        status.textContent =
          'Solicitud demostrativa: en la web real este formulario conectará con el equipo de Turbocas.';
        return;
      }

      // Pantalla de confirmación con el resumen de lo indicado.
      summaryList.replaceChildren();
      for (const [name, label] of Object.entries(LABELS)) {
        let value = '';
        if (name === 'tipo') {
          const checkedRadio = form.querySelector<HTMLInputElement>('input[name="tipo"]:checked');
          value = checkedRadio?.value === 'taller' ? 'Sí, soy un taller profesional' : 'No, soy particular';
        } else {
          const field = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
            `[name="${name}"]`,
          );
          value = field?.value.trim() ?? '';
        }
        if (!value) continue;
        const row = document.createElement('div');
        const dt = document.createElement('dt');
        dt.textContent = label;
        const dd = document.createElement('dd');
        dd.textContent = value;
        row.append(dt, dd);
        summaryList.append(row);
      }

      form.hidden = true;
      summary.hidden = false;
      summaryTitle?.focus();
    });

    wrap.querySelector<HTMLButtonElement>('[data-edit]')?.addEventListener('click', () => {
      if (!summary) return;
      summary.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLElement>('select, input, textarea')?.focus();
    });
  });
</script>

<style>
  .demo-form {
    display: grid;
    gap: var(--s-4);
  }

  .form-title {
    font-size: var(--fs-h3);
    font-weight: 700;
  }

  .form-intro {
    color: var(--text-muted);
  }

  .notice {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
    padding: var(--s-3) var(--s-4);
    background: var(--workshop-50);
    border: 1px solid var(--border);
    border-left: 3px solid var(--turbo-500);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    line-height: 1.45;
    font-weight: 500;
  }

  .notice :global(svg) {
    flex: none;
    margin-top: 1px;
  }

  form {
    display: grid;
    gap: var(--s-4);
  }

  .fieldset-tipo {
    border: none;
    padding: 0;
    margin: 0;
  }

  .fieldset-tipo .label {
    margin-bottom: var(--s-2);
    display: block;
  }

  .radios {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }

  .radio-label {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }

  .radio-label input[type="radio"] {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--ink-950);
    cursor: pointer;
  }

  .row {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 560px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .check {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--s-3);
    align-items: start;
  }

  .check input {
    width: 24px;
    height: 24px;
    margin: 0;
    accent-color: var(--ink-950);
    cursor: pointer;
  }

  .check label {
    min-height: 44px;
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.5;
    cursor: pointer;
  }

  .consent .error {
    padding-left: 36px;
  }

  .submit {
    width: 100%;
    margin-top: var(--s-2);
  }

  .status:empty {
    display: none;
  }

  .status {
    padding: var(--s-3) var(--s-4);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .status.is-success {
    background: #e7f4ec;
    color: #0e5c35;
    border-left: 3px solid var(--success-600);
  }

  .status.is-error {
    background: #fdece8;
    color: var(--signal-700);
    border-left: 3px solid var(--signal-500);
  }

  .from-ref {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
    padding: var(--s-3) var(--s-4);
    border: 1px dashed var(--steel-500);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .from-ref :global(svg) {
    flex: none;
    margin-top: 1px;
  }

  /* Confirmación */
  .summary {
    display: grid;
    gap: var(--s-4);
  }

  .sum-title {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--fs-h3);
    font-weight: 700;
  }

  .sum-title:focus {
    outline: none;
  }

  .sum-check {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    background: #e7f4ec;
    color: var(--success-600);
  }

  .sum-demo {
    border-left-color: var(--success-600);
  }

  .sum-list {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .sum-list :global(div) {
    display: grid;
    gap: 2px;
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 560px) {
    .sum-list :global(div) {
      grid-template-columns: 180px 1fr;
      gap: var(--s-4);
    }
  }

  .sum-list :global(dt) {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--steel-700);
  }

  .sum-list :global(dd) {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .sum-next {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .sum-steps {
    list-style: none;
    display: grid;
    gap: var(--s-2);
  }

  .sum-steps li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--s-2);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .sum-steps span {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink-950);
  }

  .sum-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
