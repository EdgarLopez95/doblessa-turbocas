---
interface Props {
  ratio?: '6-6' | '5-7' | '7-5';
  reverse?: boolean;
  align?: 'center' | 'start';
}

const { ratio = '6-6', reverse = false, align = 'center' } = Astro.props;
---

<div class:list={['split', `r-${ratio}`, { reverse }, `a-${align}`]}>
  <div class="copy"><slot /></div>
  <div class="media"><slot name="media" /></div>
</div>

<style>
  .split {
    display: grid;
    gap: var(--s-10);
  }

  .copy {
    display: grid;
    gap: var(--s-4);
    align-content: center;
    justify-items: start;
  }

  .copy > :global(*) {
    max-width: 100%;
  }

  @media (min-width: 960px) {
    .split {
      column-gap: var(--s-16);
    }
    .a-center {
      align-items: center;
    }
    .a-start {
      align-items: start;
    }
    .r-6-6 {
      grid-template-columns: 1fr 1fr;
    }
    .r-5-7 {
      grid-template-columns: 5fr 7fr;
    }
    .r-7-5 {
      grid-template-columns: 7fr 5fr;
    }
    .reverse .copy {
      order: 2;
    }
  }
</style>
