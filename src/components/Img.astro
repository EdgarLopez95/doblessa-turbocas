---
import { img } from '../lib/url';
import { webpOf } from '../lib/images';

interface Props {
  /** Ruta relativa a public/images/ */
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Solo para el hero real de la página. */
  priority?: boolean;
  class?: string;
}

const { src, alt, width, height, priority = false, class: className } = Astro.props;
const webp = webpOf(src);
const common = {
  src: img(src),
  alt,
  width,
  height,
  class: className,
  loading: priority ? ('eager' as const) : ('lazy' as const),
  decoding: 'async' as const,
  fetchpriority: priority ? ('high' as const) : undefined,
};
---

{
  webp ? (
    <picture class="pic">
      <source srcset={img(webp)} type="image/webp" />
      <img {...common} />
    </picture>
  ) : (
    <img {...common} />
  )
}
