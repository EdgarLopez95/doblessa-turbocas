---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { img } from '../lib/url';

interface Item {
  title: string;
  text: string;
  /** Ilustración de marca en public/images (decorativa) */
  image?: { src: string; width: number; height: number };
  icon?: IconName;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="trust">
  {
    items.map((item, i) => (
      <li class="item" data-reveal style={`--i: ${i}`}>
        <span class="mark">
          {item.image ? (
            <img src={img(item.image.src)} alt="" width={item.image.width} height={item.image.height} loading="lazy" />
          ) : (
            item.icon && <Icon name={item.icon} size={28} />
          )}
        </span>
        <div>
          <h3 class="title">{item.title}</h3>
          <p class="text">{item.text}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .trust {
    list-style: none;
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 640px) {
    .trust {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .trust {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
    .item + .item {
      border-left: 1px solid var(--border);
    }
    .item {
      padding-inline: var(--s-6);
    }
    .item:first-child {
      padding-left: 0;
    }
  }

  .item {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-sm);
    background: var(--ink-950);
    color: var(--turbo-500);
  }

  .mark img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .title {
    font-size: 1.375rem;
  }

  .text {
    margin-top: var(--s-2);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
</style>
