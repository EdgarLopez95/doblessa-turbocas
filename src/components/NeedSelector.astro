---
import Icon from './Icon.astro';
import { needs } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  tag?: string;
}

const { title = '¿Qué necesita tu vehículo?', tag = 'Empieza por el síntoma' } = Astro.props;
---

<section class="needs" aria-labelledby="necesidad-titulo">
  <div class="head">
    <p class="tag">{tag}</p>
    <h2 id="necesidad-titulo">{title}</h2>
  </div>
  <ul class="list">
    {
      needs.map((n, i) => (
        <li data-reveal style={`--i: ${i}`}>
          <a class="need" href={url(n.href)}>
            <span class="icon">
              <Icon name={n.icon} />
            </span>
            <span class="text">
              <span class="label">{n.label}</span>
              <span class="detail">{n.detail}</span>
            </span>
            <Icon name="arrow" size={20} class="go" />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .needs {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--s-6);
    box-shadow: 0 24px 48px -32px rgb(17 24 39 / 0.35);
  }

  @media (min-width: 1200px) {
    .needs {
      padding: var(--s-6) var(--s-6) var(--s-6) var(--s-10);
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: var(--s-6);
      align-items: center;
    }
  }

  .head {
    display: grid;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }

  @media (min-width: 1200px) {
    .head {
      margin-bottom: 0;
    }
  }

  h2 {
    font-size: 1.875rem;
  }

  .list {
    list-style: none;
    display: grid;
    gap: var(--s-2);
  }

  @media (min-width: 640px) {
    .list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .list {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .need {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 100%;
    min-height: 64px;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  @media (min-width: 1024px) {
    .need {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--s-4);
    }
  }

  .need:hover {
    border-color: var(--ink-950);
    background: var(--workshop-50);
  }

  .icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--turbo-500);
    color: var(--ink-950);
  }

  .text {
    display: grid;
    gap: 2px;
    flex: 1;
  }

  .label {
    font-weight: 600;
    line-height: 1.3;
  }

  .detail {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .need :global(.go) {
    flex: none;
    transition: transform var(--dur) var(--ease-out);
  }

  @media (min-width: 1024px) {
    .need :global(.go) {
      position: absolute;
      top: var(--s-4);
      right: var(--s-4);
    }
  }

  .need:hover :global(.go) {
    transform: translateX(4px);
  }
</style>
