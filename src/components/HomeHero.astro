---
import Icon from './Icon.astro';
import { business } from '../data/site';
import { img, url } from '../lib/url';

const parts = ['Entrada del compresor', 'Actuador de geometría variable', 'Brida de turbina'];
const poster = img('inicio/hero-taller-castellon.jpg');
---

<section class="hero surface-dark">
  <!-- Fondo decorativo: poster como base (LCP) y vídeo de taller encima, siempre bajo un velo tinta. -->
  <div class="hero-media" aria-hidden="true">
    <img class="hero-poster" src={poster} alt="" width="1280" height="502" decoding="async" fetchpriority="high" />
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster={poster}
      aria-hidden="true"
      data-hero-video
    >
      <source src={url('videos/hero-taller-castellon.webm')} type="video/webm" />
      <source src={url('videos/hero-taller-castellon.mp4')} type="video/mp4" />
    </video>
    <div class="hero-tint"></div>
    <div class="hero-veil"></div>
  </div>

  <script is:inline>
    (() => {
      // Sin movimiento para quien lo pide y sin descarga de vídeo con ahorro de datos: queda solo el poster.
      const video = document.querySelector('[data-hero-video]');
      if (!video) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saveData = Boolean(navigator.connection && navigator.connection.saveData);
      if (reduce || saveData) {
        video.pause();
        video.removeAttribute('autoplay');
        video.remove();
      }
    })();
  </script>

  <div class="container grid">
    <div class="copy">
      <p class="tag">Laboratorio de turbos · FAP · Direcciones hidráulicas</p>
      <h1>Reparación y reconstrucción de turbos en Castellón</h1>
      <p class="lead">
        <strong>Recupera el rendimiento de tu vehículo.</strong> Diagnosticamos, reconstruimos y comprobamos en banco
        turbocompresores, filtros de partículas y direcciones hidráulicas para particulares y talleres, en Castellón y
        fuera de la provincia.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={url('contacto/#formulario')}>Diagnosticar mi caso <Icon name="arrow" /></a>
        <a class="link-arrow on-dark-link" href={url('servicios/')}>Ver servicios <Icon name="arrow" /></a>
        <a class="link-arrow on-dark-link" href={`${url('contacto/')}?tipo=taller#formulario`}>Soy un taller profesional <Icon name="arrow" /></a>
      </div>
      <p class="call">
        ¿Prefieres contarlo por teléfono? <a href={business.phoneHref}>Llama al {business.phoneDisplay}</a>
      </p>
    </div>

    <figure class="visual">
      <div class="stage">
        <svg class="dims" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M6 98.5H94M6 97v3M94 97v3M1.5 6V94M0 6h3M0 94h3"></path>
        </svg>
        <div class="plate">
          <!-- Carga inmediata (visible en escritorio) pero sin prioridad alta: el LCP es el poster del vídeo. -->
          <picture class="pic">
            <source srcset={img('catalogo/turbo-gt2052v-audi-v6-tdi.webp')} type="image/webp" />
            <img
              class="turbo"
              src={img('catalogo/turbo-gt2052v-audi-v6-tdi.jpg')}
              alt="Turbocompresor de geometría variable GT2052V con entrada del compresor, actuador y brida de turbina"
              width="1000"
              height="1000"
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>
        <svg class="callouts" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
          <polyline style="--d: 0" pathLength="1" points="51.6,31.4 58,6 100,6"></polyline>
          <circle cx="51.6" cy="31.4" r="1.2"></circle>
          <polyline style="--d: 1" pathLength="1" points="75.1,50 86,74 100,74"></polyline>
          <circle cx="75.1" cy="50" r="1.2"></circle>
          <polyline style="--d: 2" pathLength="1" points="29.8,66.2 18,94 0,94"></polyline>
          <circle cx="29.8" cy="66.2" r="1.2"></circle>
        </svg>
        {
          parts.map((p, i) => (
            <span class:list={['callout', `c${i + 1}`]} aria-hidden="true">
              <b>{String(i + 1).padStart(2, '0')}</b>
              <span class="c-text">{p}</span>
            </span>
          ))
        }
      </div>
      <ol class="legend" aria-label="Partes señaladas">
        {parts.map((p, i) => <li><b>{String(i + 1).padStart(2, '0')}</b> {p}</li>)}
      </ol>
      <figcaption class="motto">Precisión que devuelve potencia</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ink-950);
    padding-block: var(--s-10) 120px;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--s-16) 152px;
    }
  }

  /* ---------- Capa de fondo ---------- */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* El material llega etalonado en rojo: se pasa a gris con más luz para que se lea el taller. */
    filter: grayscale(1) brightness(1.05) contrast(1.15);
  }

  /* Virado frío hacia la tinta del sistema (sin rojo ni ámbar en el fondo). */
  .hero-tint {
    position: absolute;
    inset: 0;
    background: var(--steel-500);
    mix-blend-mode: color;
    opacity: 0.55;
  }

  /*
   * Velo por zonas. El contenedor está centrado, así que la columna de texto termina hacia 50% + 80px
   * en cualquier ancho de escritorio: denso de 50% − 620px (inicio del texto) a 50% + 90px; abierto también en el margen izquierdo en pantallas anchas (texto ≥ 8:1 medido), abierto entre texto y placa
   * y a la derecha para que se lea el vídeo, y fundido inferior hacia el selector de síntomas.
   */
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, var(--ink-950) 0%, rgb(17 24 39 / 0) 34%),
      linear-gradient(
        90deg,
        rgb(17 24 39 / 0.4) 0%,
        rgb(17 24 39 / 0.9) calc(50% - 620px),
        rgb(17 24 39 / 0.88) calc(50% + 90px),
        rgb(17 24 39 / 0.4) calc(50% + 190px),
        rgb(17 24 39 / 0.25) 100%
      );
  }

  /* Retícula técnica muy tenue sobre el velo, sin competir con la imagen. */
  .hero-veil::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  @media (max-width: 959px) {
    /* En móvil y tablet el texto acaba hacia el 52% del alto (medido a 360–768 px): velo denso hasta el 55% y abierto alrededor de la placa. */
    .hero-veil {
      background:
        linear-gradient(0deg, var(--ink-950) 0%, rgb(17 24 39 / 0) 14%),
        linear-gradient(180deg, rgb(17 24 39 / 0.86) 0%, rgb(17 24 39 / 0.84) 55%, rgb(17 24 39 / 0.6) 68%, rgb(17 24 39 / 0.6) 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Respaldo sin JS: nunca se muestra movimiento. */
    .hero-video {
      display: none;
    }
  }

  /* ---------- Contenido ---------- */
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s-10);
    align-items: center;
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .copy {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2.625rem, 1.5rem + 3.6vw, 4rem);
    line-height: 1.02;
  }

  .lead strong {
    color: var(--white);
    font-weight: 600;
  }

  .on-dark-link {
    color: var(--white);
  }

  .call {
    font-size: 0.9375rem;
    color: var(--steel-300);
  }

  .call a {
    color: var(--white);
    font-weight: 600;
    text-decoration-color: var(--turbo-500);
    text-decoration-thickness: 2px;
    display: inline-block;
    padding-block: 10px;
  }

  /* ---------- Placa técnica del turbo ---------- */
  .visual {
    margin: 0;
    justify-self: center;
    width: min(100%, 340px);
  }

  @media (min-width: 960px) {
    .visual {
      justify-self: end;
      width: min(100%, 400px);
    }
  }

  .stage {
    position: relative;
    aspect-ratio: 1 / 1;
  }

  .dims {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--turbo-500);
    stroke-width: 0.35;
    opacity: 0.7;
  }

  .plate {
    position: absolute;
    inset: 6%;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.8);
    overflow: hidden;
  }

  .plate :global(.turbo) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4%;
  }

  .callouts {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .callouts polyline {
    fill: none;
    stroke: var(--turbo-600);
    stroke-width: 0.35;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .callouts circle {
    fill: var(--turbo-500);
    stroke: var(--ink-950);
    stroke-width: 0.4;
  }

  .callout {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    background: var(--ink-950);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 2px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--white);
    transform: translateY(-50%);
  }

  .callout b {
    color: var(--turbo-500);
  }

  .c-text {
    display: none;
  }

  .c1 {
    right: 0;
    top: 6%;
  }

  .c2 {
    right: 0;
    top: 74%;
  }

  .c3 {
    left: 0;
    top: 94%;
  }

  /* Fondo tinta propio: legible aunque la zona de la placa quede con el velo abierto. */
  .legend {
    list-style: none;
    display: grid;
    gap: 4px;
    margin: var(--s-6) 0 0;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--radius-sm);
    background: rgb(17 24 39 / 0.85);
    font-size: 0.875rem;
    color: var(--steel-300);
  }

  .legend b {
    font-family: var(--font-display);
    color: var(--turbo-500);
    margin-right: 6px;
  }

  /* Textos de las cotas solo en escritorio, donde la placa flota a la derecha. */
  @media (min-width: 960px) {
    .c-text {
      display: inline;
    }
    .legend {
      display: none;
    }
  }

  /* El lema lleva su propio fondo tinta: legible sea cual sea el fotograma de detrás. */
  .motto {
    display: table;
    margin: var(--s-4) auto 0;
    padding: 4px 10px;
    border-radius: 2px;
    background: rgb(17 24 39 / 0.85);
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--steel-300);
  }

  /* Dibujo de cotas solo en escritorio y con movimiento permitido: en móvil no hay nada animado junto a los botones. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 960px) {
    .plate {
      animation: rise 240ms var(--ease-out) both;
    }
    .callouts polyline {
      animation: draw 240ms var(--ease-out) both;
      animation-delay: calc(280ms + var(--d) * 80ms);
    }
    .callouts circle,
    .callout {
      animation: fade 200ms var(--ease-out) both;
      animation-delay: 520ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>
