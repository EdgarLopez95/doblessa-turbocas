---
import Icon from './Icon.astro';
import { business } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  tag?: string;
}

const {
  title = 'Cuéntanos tu caso y te decimos cómo seguir',
  text = 'Indica qué vehículo tienes y qué notas. Revisamos la información y te orientamos sobre el diagnóstico y el presupuesto.',
  ctaLabel = 'Solicitar presupuesto',
  ctaHref = 'contacto/#formulario',
  tag = 'Presupuesto',
} = Astro.props;
---

<!-- Card oscura sobre fondo claro: separa el CTA del footer aunque compartan la tinta. -->
<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="container">
    <div class="card surface-dark blueprint">
      <div class="inner">
        <div class="copy">
          <p class="tag">{tag}</p>
          <h2 id="cta-band-title">{title}</h2>
          <p class="lead">{text}</p>
        </div>
        <div class="side">
          <a class="btn btn-primary big" href={url(ctaHref)}>
            {ctaLabel}
            <Icon name="arrow" />
          </a>
          <p class="or">o llama directamente</p>
          <a class="phone" href={business.phoneHref}>
            <Icon name="phone" size={28} />
            {business.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Card tinta completa sobre fondo claro, con aire arriba y abajo: el fondo claro separa el CTA del footer.
   * Sin solape a propósito: card y footer comparten tinta y la zona solapada volvería a fundirse con el pie.
   */
  .cta-band {
    padding-block: var(--s-16);
    background: var(--surface-base);
  }

  @media (min-width: 1024px) {
    .cta-band {
      padding-block: var(--s-24);
    }
  }

  .card {
    overflow: hidden;
    border-radius: var(--radius);
    border-top: 3px solid var(--turbo-500);
    box-shadow: 0 32px 64px -32px rgb(17 24 39 / 0.55);
    padding: var(--s-10) var(--s-6);
  }

  @media (min-width: 768px) {
    .card {
      padding: var(--s-16) var(--s-10);
    }
  }

  @media (min-width: 1024px) {
    .card {
      padding: var(--s-16);
    }
  }

  .inner {
    display: grid;
    gap: var(--s-10);
    align-items: center;
  }

  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 7fr 5fr;
      gap: var(--s-16);
    }
  }

  .copy {
    display: grid;
    gap: var(--s-4);
  }

  h2 {
    font-size: clamp(2.125rem, 1.5rem + 2vw, 3rem);
    max-width: 18ch;
  }

  .side {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-6);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-left: 3px solid var(--turbo-500);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.04);
  }

  .big {
    min-height: 56px;
    font-size: 1rem;
  }

  .or {
    margin-top: var(--s-2);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel-300);
  }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 48px;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.5rem + 1.2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--white);
  }

  .phone :global(svg) {
    color: var(--turbo-500);
  }

  .phone:hover {
    color: var(--turbo-500);
  }
</style>
